# Frontend Port
FRONTEND_PORT=3000

# Backend API URLs
# NEXT_PUBLIC_BACKEND_URL is used by client-side components in the browser
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# BACKEND_INTERNAL_URL is used by Next.js Server-Side Rendering (SSR) & API routes inside Docker
BACKEND_INTERNAL_URL=http://host.docker.internal:8080

# NextAuth Configuration
NEXTAUTH_SECRET=super_secret_hotel_nextauth_token_key_change_in_prod
NEXTAUTH_URL=http://localhost:3000

#Registry Config
FRONTEND_REGISTRY_URL=
FRONTEND_IMAGE_NAME=
FRONTEND_IMAGE_TAG=